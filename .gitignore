# ── PyInstaller build artifacts ────────────────────────────────────────────
dist/
build/

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Virtual environments ───────────────────────────────────────────────────
.venv/
venv/
env/

# ── Conversor: arquivos de entrada e saída ─────────────────────────────────
# Não versionar .bib (dados privados do usuário) nem os HTML/MD gerados
*.bib
*.html

# ── Atalhos do Windows (contêm paths pessoais) ─────────────────────────────
*.lnk

# ── Configurações locais do Claude Code (não devem ir pro repo) ────────────
.claude/settings.local.json

# ── Sistema operacional ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Sujeira de testes locais (Cowork) ──────────────────────────────────────
.cowork_touch
.gitignore.test
.claude/.writetest
_push_changes.bat
